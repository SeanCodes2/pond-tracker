{
  "name": "@pond-tracker/shared",
  "version": "0.1.0",
  "description": "Shared domain types and fisheries math (relative weight, PSD, cull guidance) for Pond Tracker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6",
    "vitest": "^2"
  }
}
